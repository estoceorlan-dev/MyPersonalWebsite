# Neon Serverless PostgreSQL connection string
# Example: postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Initial Owner Dashboard credentials (seeded on first run; can also be changed inside the Owner Dashboard)
OWNER_EMAIL=estoce.orlan@gmail.com
OWNER_PASSWORD=Orlandone2026!

# Secret key for signing owner JWT tokens
JWT_SECRET=replace-with-a-long-random-secret-string

# Optional: Frontend URL if hosting frontend on Vercel and backend on Render
# Example: https://www.orlanestoce.online
CORS_ORIGIN=

# Optional: Frontend build-time API base URL (leave empty if served from same origin, or set to https://your-service.onrender.com)
VITE_API_BASE_URL=

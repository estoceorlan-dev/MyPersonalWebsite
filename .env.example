# Neon Lakebase Postgres & Neon Functions variables (populated by `neon deploy` / `neon env pull` into .env.local)
# Pooled connection string (-pooler) for application query traffic
DATABASE_URL=
# Direct connection string (unpooled) for schema migrations / DDL
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_BRANCH_ID=br-ancient-field-b36wqdbh
NEON_FUNCTION_HOST_SUFFIX=.compute.c-4.ap-southeast-1.aws.neon.tech

# Initial Owner Dashboard credentials (seeded on first run; can also be changed inside the Owner Dashboard)
OWNER_EMAIL=estoce.orlan@gmail.com
OWNER_PASSWORD=Orlandone2026!

# Secret key for signing owner JWT tokens
JWT_SECRET=replace-with-a-long-random-secret-string

# Optional: Allowed CORS origin(s)
CORS_ORIGIN=

# Optional: Override API base URL (by default, production builds automatically use the deployed Neon Function URL via functionBaseUrl("api"))
# Live Neon Function URL: https://br-ancient-field-b36wqdbh-api.compute.c-4.ap-southeast-1.aws.neon.tech
VITE_API_BASE_URL=
